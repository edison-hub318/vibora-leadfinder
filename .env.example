# Copy this file to .env (PowerShell:  copy .env.example .env) and fill in your values.
# Never commit .env - it holds your keys and passwords.

# --- Google (required for search, audits and refresh) ---
GOOGLE_API_KEY=

# --- Companies House (optional, free: https://developer.company-information.service.gov.uk/) ---
COMPANIES_HOUSE_API_KEY=

# --- Email sending (SMTP). Port 587 uses STARTTLS, port 465 uses SSL. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_NAME=Vibora
FROM_EMAIL=
DAILY_SEND_LIMIT=30

# --- You (used in call openers, email footers and preview pages) ---
MY_NAME=
MY_PHONE=
BUSINESS_ADDRESS=

# --- Backups: point this at a OneDrive or Google Drive folder, e.g. C:\Users\you\OneDrive\LeadfinderBackups ---
BACKUP_DIR=

# --- Optional extras ---
NETLIFY_AUTH_TOKEN=
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_MAX_PER_SEARCH=30

# --- Google free-tier protection (leave FREE_TIER_MODE=true to pay nothing) ---
FREE_TIER_MODE=true
FREE_TIER_SAFETY=0.9
MONTHLY_API_BUDGET_GBP=20

# --- Dashboard ---
# 127.0.0.1 = this PC only. Set to your Tailscale IP (100.x.y.z) to share privately. Never 0.0.0.0.
BIND_HOST=127.0.0.1

# Generated automatically on first run if left empty. Keep it secret.
SECRET_KEY=
